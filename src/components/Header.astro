---
import { SITE } from '../config';
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (href: string) => href === '/' ? pathname.replace(/\/$/, '') === base : pathname.startsWith(`${base}${href}`);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={`${base}/`} class="logo">{SITE.title}</a>
    <nav class="nav">
      <a href={`${base}/`} class:list={[{ active: isActive('/') }]}>글</a>
      <a href={`${base}/about/`} class:list={[{ active: isActive('/about') }]}>소개</a>
      <a href={`${base}/subscribe/`} class:list={[{ active: isActive('/subscribe') }]}>구독</a>
    </nav>
  </div>
</header>
