---
import { SITE } from '../config';
const { pathname } = Astro.url;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a href={`${import.meta.env.BASE_URL}/`} class="logo">
      <img src={`${import.meta.env.BASE_URL}/teimakes-mark.png`} class="brand-mark" width="40" height="40" alt="" />
      <span>{SITE.title}</span>
    </a>
    <nav class="nav">
      <a href={`${import.meta.env.BASE_URL}/`} class:list={[{ active: isActive('/') }]}>Blog</a>
      <a href={`${import.meta.env.BASE_URL}/about`} class:list={[{ active: isActive('/about') }]}>About</a>
      <a href={`${import.meta.env.BASE_URL}/links/`} class:list={[{ active: isActive('/links') }]}>Links</a>
      <a href={`${import.meta.env.BASE_URL}/subscribe`} class:list={[{ active: isActive('/subscribe') }]}>Subscribe</a>
    </nav>
  </div>
</header>
