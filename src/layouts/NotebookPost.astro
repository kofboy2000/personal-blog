---
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  html?: string;
  date?: string;
  tags?: string[];
  layout?: string;
}

const { title, description, html, date, tags, layout = 'centered' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.description}`;
const desc = description || SITE.description;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="article" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${import.meta.env.BASE_URL}/rss.xml`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body class:list={['notebook-page', `layout-${layout}`]}>
    <Header />
    <main class="notebook-main">
      <article class="notebook-article">
        <header class="article-header">
          <h1>{title}</h1>
          <div class="post-meta">
            {date && <time datetime={new Date(date).toISOString()}>{fmt(new Date(date))}</time>}
            {tags && tags.length > 0 && (
              <span class="post-tags">{tags.map((t: string) => `#${t}`).join(' ')}</span>
            )}
          </div>
        </header>
        <div class="notebook-body" set:html={html} />
      </article>
      <div class="subscribe-box">
        <h2>Enjoyed this post?</h2>
        <p>Subscribe to get new posts in your inbox. No spam, ever.</p>
        <form class="subscribe-form" action={`${import.meta.env.BASE_URL}/subscribe`} method="get">
          <input type="email" name="email" placeholder="you@example.com" required />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </main>
    <Footer />
  </body>
</html>
