---
import { SITE } from '../config';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
    <nav class="footer-nav">
      <a href={`${import.meta.env.BASE_URL}/rss.xml`}>RSS</a>
      <a href={`${import.meta.env.BASE_URL}/feed.json`}>JSON</a>
      <a href={SITE.social.github}>GitHub</a>
      <a href={SITE.social.twitter}>Twitter/X</a>
      <a href={SITE.social.email}>Contact</a>
      <a href={`${import.meta.env.BASE_URL}/privacy`}>Privacy</a>
    </nav>
  </div>
</footer>
