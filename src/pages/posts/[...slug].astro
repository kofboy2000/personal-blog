---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const postImportResult = import.meta.glob('./**/*.{md,mdx}', { eager: true });
  return Object.entries(postImportResult).map(([path, post]) => ({
    params: { slug: path.replace('./', '').replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---

<Base title={post.frontmatter.title} description={post.frontmatter.description}>
  <article>
    <header class="article-header">
      <h1>{post.frontmatter.title}</h1>
      <div class="post-meta">
        <time datetime={new Date(post.frontmatter.date).toISOString()}>
          {fmt(new Date(post.frontmatter.date))}
        </time>
        {post.frontmatter.tags && (
          <span class="post-tags">
            {post.frontmatter.tags.map((t: string) => `#${t}`).join(' ')}
          </span>
        )}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  <div class="subscribe-box">
    <h2>Enjoyed this post?</h2>
    <p>Subscribe to get new posts in your inbox. No spam, ever.</p>
    <form class="subscribe-form" action="/subscribe" method="get">
      <input type="email" name="email" placeholder="you@example.com" required />
      <button type="submit">Subscribe</button>
    </form>
  </div>
</Base>
