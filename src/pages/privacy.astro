---
import Base from '../layouts/Base.astro';
---

<Base title="Privacy">
  <section class="hero">
    <h1>Privacy</h1>
    <p>Short version: I don't collect or share your data.</p>
  </section>

  <div class="prose">
    <p>
      This site is a static blog. It doesn't run analytics, tracking pixels, or third-party ad scripts.
      If you subscribe to the newsletter, your email address is used solely to send you new posts.
      You can unsubscribe at any time.
    </p>
    <p>
      Questions? Feel free to <a href="mailto:hello@example.com">reach out</a>.
    </p>
  </div>
</Base>
